---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": "{{ site.fullName }}",
  "short_name": "{{ site.name }}",
  "start_url": "{{ '/' | url }}",
  "display": "browser",
  "background_color": "#fbf8f3",
  "theme_color": "#191a17",
  "icons": [
    { "src": "{{ '/apple-touch-icon.png' | url }}", "sizes": "180x180", "type": "image/png" },
    { "src": "{{ '/assets/icon-512.png' | url }}", "sizes": "512x512", "type": "image/png" }
  ]
}
