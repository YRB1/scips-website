---
layout: layouts/base.njk
---
{% set toc = content | toc %}
<header class="page-header" data-theme="dark">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/guides/">Guides</a></li>
        <li><span aria-current="page">{{ short or title }}</span></li>
      </ol>
    </nav>
    <p class="kicker mt-m">Guide · {{ readingTime }} read</p>
    <h1 data-split>{{ title }}</h1>
    <p class="lede">{{ summary }}</p>
  </div>
</header>
<div class="section">
  <div class="container with-sidebar">
    <aside class="guide-aside">
      {% if toc.length %}
      <nav class="toc" aria-labelledby="toc-title" data-toc>
        <h2 id="toc-title">Contents</h2>
        <ol>{% for h in toc %}<li><a href="#{{ h.id }}">{{ h.text }}</a></li>{% endfor %}</ol>
      </nav>
      {% endif %}
      <button class="button button--secondary guide-print" type="button" data-print hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 1h8v4H4zM2 6h12v6h-2v3H4v-3H2zM5 10v4h6v-4z" fill="currentColor" fill-rule="evenodd"/></svg>
        Print this guide
      </button>
    </aside>
    <article class="prose guide">
      {{ content | safe }}
      <div class="guide-tools" aria-label="Share and feedback">
        <div class="share" data-share data-title="{{ title }}" data-url="{{ site.liveUrl }}{{ page.url }}">
          <h2 class="guide-tools__heading">Share this guide</h2>
          <div class="share__buttons">
            <a class="share__btn" href="https://wa.me/?text={{ (title + ' ' + site.liveUrl + page.url) | urlencode }}" rel="noopener" target="_blank">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.4-.7-2.8-1.1-4.6-4-4.8-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l2 1c.3.1.5.2.5.3.1.2.1.8-.1 1.4z" fill="currentColor"/></svg>WhatsApp</a>
            <a class="share__btn" href="mailto:?subject={{ title | urlencode }}&amp;body={{ ('I thought this guide from SCIPS might be useful: ' + site.liveUrl + page.url) | urlencode }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="m3 7 9 6 9-6" fill="none" stroke="currentColor" stroke-width="2"/></svg>Email</a>
            <button class="share__btn" type="button" data-copy hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" fill="none" stroke="currentColor" stroke-width="2"/></svg><span>Copy link</span></button>
          </div>
        </div>
        <div class="feedback" data-feedback>
          <h2 class="guide-tools__heading" id="fb-q">Was this guide useful?</h2>
          <div class="share__buttons" role="group" aria-labelledby="fb-q">
            <button class="share__btn" type="button" data-fb="yes">Yes</button>
            <button class="share__btn" type="button" data-fb="no">No</button>
          </div>
          <p class="feedback__thanks" data-fb-yes hidden role="status">Thank you. If your group needs more help, <a href="/contact/">get in touch</a>.</p>
          <p class="feedback__thanks" data-fb-no hidden role="status">Sorry about that. <a href="mailto:{{ site.email }}?subject={{ ('Feedback on guide: ' + title) | urlencode }}">Tell us what was missing</a> and we'll improve it.</p>
        </div>
      </div>
      <p class="muted guide-meta">{% if site.concept %}Draft guide for SCIPS to review.{% else %}Last reviewed November 2026.{% endif %} Information is general and not legal advice.</p>
    </article>
  </div>
</div>
<section class="section section--stone" aria-labelledby="more-guides">
  <div class="container">
    <h2 id="more-guides" class="h3-size">More guides</h2>
    <ul class="guide-mini mt-m">
      {% for g in collections.guide | sort(false, false, "data.order") %}{% if g.url != page.url %}
      <li><a href="{{ g.url }}">{{ g.data.title }}</a></li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>
{% include "partials/cta.njk" %}
