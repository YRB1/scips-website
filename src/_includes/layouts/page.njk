---
layout: layouts/base.njk
---
<header class="page-header{% if headerPhoto %} page-header--photo{% endif %}" data-theme="dark"{% if headerPhoto %} data-scene="header"{% endif %}>
  {% if headerPhoto %}
  <div class="page-header__bg" aria-hidden="true">{% picture headerPhoto, "100vw", { loading: "eager", widths: [800, 1024] } %}</div>
  {% endif %}
  <div class="container page-header__inner">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><span aria-current="page">{{ crumb or title }}</span></li>
      </ol>
    </nav>
    <h1 data-split>{{ heading or title }}</h1>
    {% if lede %}<p class="lede">{{ lede | safe }}</p>{% endif %}
    {% if headerPhoto %}<p class="page-header__credit credit">{% credit headerPhoto %}</p>{% endif %}
  </div>
</header>
{{ content | safe }}
{% if not hideCta %}{% include "partials/cta.njk" %}{% endif %}
