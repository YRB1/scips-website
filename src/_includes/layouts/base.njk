<!doctype html>
<html lang="en-GB" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set canonicalBase = site.liveUrl if site.concept else site.url -%}
  {%- set canonical = canonicalBase + page.url -%}
  {%- set pageTitle = seoTitle or ((title + " | " + site.name) if title and page.url != "/" else site.name + ": " + site.fullName) -%}
  {%- if seoTitle and page.url != "/" %}{% set pageTitle = seoTitle + " | " + site.name %}{% endif -%}
  {%- set pageDesc = description or summary or "SCIPS supports tenants, residents and community groups across Sandwell to have a say in decisions about their homes and neighbourhoods." -%}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ canonical }}">
  {% if site.concept %}<meta name="robots" content="noindex, nofollow">{% else %}<meta name="robots" content="index, follow, max-image-preview:large">{% endif %}
  <meta name="theme-color" content="#0e1c16">
  <meta name="geo.region" content="GB-SAW">
  <meta name="geo.placename" content="West Bromwich, Sandwell">
  <meta name="geo.position" content="52.5124;-1.9803">
  <meta property="og:type" content="{{ 'article' if (tags and 'guide' in tags) else 'website' }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:title" content="{{ seoTitle or title or site.fullName }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:locale" content="en_GB">
  <meta property="og:site_name" content="{{ site.fullName }}">
  <meta property="og:image" content="{{ site.liveUrl }}/assets/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="SCIPS: helping Sandwell residents have a say in their homes and neighbourhoods">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seoTitle or title or site.fullName }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ site.liveUrl }}/assets/og.png">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/hanken-grotesk-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/newsreader-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css">
  <script>document.documentElement.classList.replace("no-js", "js");if(!matchMedia("(prefers-reduced-motion: reduce)").matches){document.documentElement.classList.add("motion");{% if page.url == "/" %}try{if(!sessionStorage.getItem("scips-intro"))document.documentElement.classList.add("intro-on")}catch(e){}{% endif %}}</script>
  {% include "partials/schema.njk" %}
</head>
<body class="{{ 'is-home' if page.url == '/' else 'is-inner' }}">
  {% if page.url == "/" %}<div class="intro" data-intro aria-hidden="true">
    <svg class="intro__mark" viewBox="0 0 40 40"><path d="M9 31V18.5L20 10l11 8.5V31h-7.5v-8h-7v8z" pathLength="1"/></svg>
    <p class="intro__word">SCIPS</p>
    <p class="intro__count"><span data-intro-count>000</span></p>
    <p class="intro__place">Sandwell</p>
  </div>{% endif %}
  <a class="skip-link" href="#main">Skip to main content</a>
  {% include "partials/header.njk" %}
  <main id="main" tabindex="-1"{% if searchable !== false %} data-pagefind-body{% endif %}>
    {{ content | safe }}
  </main>
  {% include "partials/pill.njk" %}
  {% include "partials/footer.njk" %}
  <script src="/assets/js/main.js" defer></script>
</body>
</html>
