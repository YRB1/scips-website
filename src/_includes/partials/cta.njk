{% from "partials/icons.njk" import arrow %}
<section class="cta" aria-labelledby="cta-title">
  <div class="container cta__grid">
    <h2 id="cta-title">Not sure where to start? <span>Talk to us.</span></h2>
    <div class="cta__actions">
      <a class="cta__phone" href="tel:{{ site.phoneHref }}">{{ site.phone }}</a>
      <p>{{ site.hours }}</p>
      <a class="button button--brand" href="/contact/">Send us a message {{ arrow() | safe }}</a>
    </div>
  </div>
</section>
