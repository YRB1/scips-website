<div class="site-head" data-site-head>
<div class="utility">
  <div class="container">
    <span class="charity">Registered charity {{ site.charityNumber }}</span>
    <ul>
      <li>
        <details class="translate" data-translate>
          <summary>Translate</summary>
          <ul>
            {% set langs = [["pa","Punjabi","ਪੰਜਾਬੀ"],["ur","Urdu","اردو"],["pl","Polish","Polski"],["bn","Bengali","বাংলা"],["gu","Gujarati","ગુજરાતી"],["ro","Romanian","Română"],["ar","Arabic","العربية"],["ku","Kurdish","Kurdî"],["so","Somali","Soomaali"],["ti","Tigrinya","ትግርኛ"]] %}
            {% for l in langs %}
            <li><a href="https://translate.google.com/translate?sl=en&amp;tl={{ l[0] }}&amp;u={{ site.liveUrl }}{{ page.url }}" data-lang="{{ l[0] }}" lang="{{ l[0] }}" rel="noopener" target="_blank"><span>{{ l[2] }}</span><span lang="en">{{ l[1] }}</span></a></li>
            {% endfor %}
            <li class="note">Opens Google Translate in a new tab. Machine translation may contain mistakes.</li>
          </ul>
        </details>
      </li>
      <li class="hide-sm"><a href="/accessibility/">Accessibility</a></li>
      <li><a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></li>
    </ul>
  </div>
</div>
<header class="masthead">
  <div class="container">
    <a class="wordmark" href="/" aria-label="{{ site.name }} home">
      <svg class="wordmark__icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><rect width="40" height="40" rx="8" fill="#e2792a"/><path d="M9 31V18.5L20 10l11 8.5V31h-7.5v-8h-7v8z" fill="#14281f"/></svg>
      <span class="wordmark__mark">SCIPS</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-toggle__icon" aria-hidden="true"><span></span></span>
      Menu
    </button>
    <div class="nav" id="site-nav">
      <nav aria-label="Main">
        <ul>
          {% for item in nav %}
          <li><a href="{{ item.url }}"{% if item.url | isCurrent(page.url) %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      <form class="site-search" action="/search/" method="get" role="search" data-search-box>
        <label class="visually-hidden" for="site-search-q">Search this website</label>
        <input id="site-search-q" name="q" type="search" placeholder="Search" autocomplete="off" spellcheck="false"
          role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="site-search-list" aria-describedby="site-search-help">
        <span id="site-search-help" class="visually-hidden">Suggestions appear as you type. Use the up and down arrows to choose one.</span>
        <button type="submit" aria-label="Search"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M11 11l4 4" stroke="currentColor" stroke-width="2"/></svg></button>
        <div class="suggest" data-suggest hidden data-popular="{{ searchSuggestions | dump | escape }}">
          <p class="suggest__heading" data-suggest-heading>Popular searches</p>
          <ul class="suggest__list" id="site-search-list" role="listbox" aria-label="Search suggestions" data-suggest-list></ul>
          <p class="suggest__status visually-hidden" role="status" aria-live="polite" data-suggest-status></p>
        </div>
      </form>
    </div>
  </div>
</header>
</div>
